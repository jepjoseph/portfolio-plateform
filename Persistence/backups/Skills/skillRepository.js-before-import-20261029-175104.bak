import { getDatabasePool, sql } from "../config/database.js";

const SKILL_COLUMNS = `
  id,
  user_id,
  name,
  normalized_name,
  category,
  skill_type,
  record_status,
  skill_data,
  created_at,
  updated_at,
  row_version
`;

function mapSkillRow(row) {
  if (!row) {
    return null;
  }

  const skillData =
    typeof row.skill_data === "string"
      ? JSON.parse(row.skill_data)
      : row.skill_data;

  if (
    !skillData ||
    typeof skillData !== "object" ||
    Array.isArray(skillData)
  ) {
    throw new Error("Stored Skill data is invalid.");
  }

  return {
    ...skillData,

    // Database columns are authoritative.
    id: row.id,
    name: row.name,
    normalizedName: row.normalized_name,
    category: row.category,
    type: row.skill_type,
    status: row.record_status,

    createdAt: row.created_at,
    updatedAt: row.updated_at,
    rowVersion: Buffer.from(row.row_version).toString("base64"),
  };
}

function bindSkillParameters(request, userId, skill) {
  return request
    .input("id", sql.NVarChar(200), skill.id)
    .input("userId", sql.UniqueIdentifier, userId)
    .input("name", sql.NVarChar(150), skill.name)
    .input(
      "normalizedName",
      sql.NVarChar(150),
      skill.normalizedName,
    )
    .input("category", sql.NVarChar(100), skill.category)
    .input("skillType", sql.NVarChar(100), skill.type)
    .input("recordStatus", sql.NVarChar(20), skill.status)
    .input(
      "skillData",
      sql.NVarChar(sql.MAX),
      JSON.stringify(skill),
    );
}

export async function listSkillsByUser(userId) {
  const pool = await getDatabasePool();

  const result = await pool
    .request()
    .input("userId", sql.UniqueIdentifier, userId)
    .query(`
      SELECT ${SKILL_COLUMNS}
      FROM dbo.skills
      WHERE user_id = @userId
      ORDER BY updated_at DESC, id ASC;
    `);

  return result.recordset.map(mapSkillRow);
}

export async function findSkillById(userId, skillId) {
  const pool = await getDatabasePool();

  const result = await pool
    .request()
    .input("userId", sql.UniqueIdentifier, userId)
    .input("id", sql.NVarChar(200), skillId)
    .query(`
      SELECT ${SKILL_COLUMNS}
      FROM dbo.skills
      WHERE user_id = @userId
        AND id = @id;
    `);

  return mapSkillRow(result.recordset[0]);
}

export async function findSkillByNormalizedName(
  userId,
  normalizedName,
) {
  const pool = await getDatabasePool();

  const result = await pool
    .request()
    .input("userId", sql.UniqueIdentifier, userId)
    .input("normalizedName", sql.NVarChar(150), normalizedName)
    .query(`
      SELECT ${SKILL_COLUMNS}
      FROM dbo.skills
      WHERE user_id = @userId
        AND normalized_name = @normalizedName;
    `);

  return mapSkillRow(result.recordset[0]);
}

export async function createSkill(userId, skill) {
  const pool = await getDatabasePool();

  await bindSkillParameters(
    pool.request(),
    userId,
    skill,
  ).query(`
    INSERT INTO dbo.skills (
      id,
      user_id,
      name,
      normalized_name,
      category,
      skill_type,
      record_status,
      skill_data
    )
    VALUES (
      @id,
      @userId,
      @name,
      @normalizedName,
      @category,
      @skillType,
      @recordStatus,
      @skillData
    );
  `);

  return findSkillById(userId, skill.id);
}

export async function updateSkill(
  userId,
  skill,
  expectedRowVersion,
) {
  const pool = await getDatabasePool();

  const request = bindSkillParameters(
    pool.request(),
    userId,
    skill,
  ).input(
    "expectedRowVersion",
    sql.Binary(8),
    Buffer.from(expectedRowVersion, "base64"),
  );

  const result = await request.query(`
    UPDATE dbo.skills
    SET
      name = @name,
      normalized_name = @normalizedName,
      category = @category,
      skill_type = @skillType,
      record_status = @recordStatus,
      skill_data = @skillData,
      updated_at = SYSUTCDATETIME()
    WHERE id = @id
      AND user_id = @userId
      AND row_version = @expectedRowVersion;
  `);

  if (result.rowsAffected[0] === 0) {
    return null;
  }

  return findSkillById(userId, skill.id);
}

export async function deleteSkill(
  userId,
  skillId,
  expectedRowVersion,
) {
  const pool = await getDatabasePool();

  const result = await pool
    .request()
    .input("userId", sql.UniqueIdentifier, userId)
    .input("id", sql.NVarChar(200), skillId)
    .input(
      "expectedRowVersion",
      sql.Binary(8),
      Buffer.from(expectedRowVersion, "base64"),
    )
    .query(`
      DELETE FROM dbo.skills
      WHERE id = @id
        AND user_id = @userId
        AND row_version = @expectedRowVersion;
    `);

  return result.rowsAffected[0] > 0;
}